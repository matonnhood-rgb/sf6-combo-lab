<Window x:Class="ComboLab.Views.ComboPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="呼び出すコンボを選択"
        Width="420"
        Height="480"
        MinWidth="320"
        MinHeight="320"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="0F開始の部品として呼び出すコンボを選択してください。"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <ListBox x:Name="ComboList"
                 Grid.Row="1"
                 ItemsSource="{Binding Combos}"
                 SelectedItem="{Binding SelectedCombo, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding ComboName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Damage, StringFormat={}{0} ダメージ}"
                                   Foreground="#666666"
                                   FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="キャンセル" IsCancel="True"/>
            <Button Content="追加" IsDefault="True" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
