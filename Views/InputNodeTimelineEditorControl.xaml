<UserControl x:Class="ComboLab.Views.InputNodeTimelineEditorControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <DockPanel>
        <WrapPanel x:Name="EditorToolbar"
                   DockPanel.Dock="Top"
                   Margin="0,0,0,6">
            <Button Content="ノード追加" Click="AddInputEvent_Click"/>
            <Button Content="ノード削除" Click="DeleteInputEvent_Click"/>
            <Button Content="複製"
                    Visibility="{Binding FullVisibility, ElementName=Root}"
                    Click="DuplicateInputNode_Click"/>
            <Button Content="入力クリア"
                    Visibility="{Binding FullVisibility, ElementName=Root}"
                    Click="ClearInputNode_Click"/>
            <Button Content="F順に並べ替え"
                    Visibility="{Binding FullVisibility, ElementName=Root}"
                    Click="SortInputNodesByFrame_Click"/>
            <TextBlock Text="ズーム"
                       Margin="14,0,4,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding FullVisibility, ElementName=Root}"/>
            <Slider Width="120"
                    Minimum="16"
                    Maximum="48"
                    TickFrequency="4"
                    IsSnapToTickEnabled="True"
                    Visibility="{Binding FullVisibility, ElementName=Root}"
                    Value="{Binding PixelsPerFrame, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="テスト再生"
                    Margin="14,0,0,0"
                    Visibility="{Binding FullVisibility, ElementName=Root}"
                    Click="TestPlayback_Click"/>
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Background="#F8FAFC"
                    Height="{Binding TimelineViewportHeight, ElementName=Root}">
                <ScrollViewer x:Name="TimelineScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RequestBringIntoView="TimelineScrollViewer_RequestBringIntoView">
                    <Canvas x:Name="InputTimelineCanvas"
                            Width="{Binding InputTimelineWidth, ElementName=Root}"
                            Height="{Binding InputTimelineHeight, ElementName=Root}"
                            MouseLeftButtonDown="InputTimelineCanvas_MouseLeftButtonDown">
                        <Canvas.Background>
                            <DrawingBrush TileMode="Tile"
                                          Viewport="{Binding TimelineGridViewport, ElementName=Root}"
                                          ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Geometry="M0,0 L0,42">
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#E2E8F0" Thickness="1"/>
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Canvas.Background>

                        <ItemsControl ItemsSource="{Binding InputTimelineLaneLines, ElementName=Root}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="0"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding InputTimelineWidth, ElementName=Root}"
                                            Height="1"
                                            Background="#E2E8F0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding InputTimelineTicks, ElementName=Root}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="0"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding PixelsPerFrame, ElementName=Root}"
                                          Height="{Binding InputTimelineHeight, ElementName=Root}">
                                        <Border Width="1"
                                                HorizontalAlignment="Left"
                                                Background="#CBD5E1"/>
                                        <TextBlock Text="{Binding Label}"
                                                   Margin="2,2,0,0"
                                                   FontSize="10"
                                                   Foreground="#475569"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding InputNodeRows, ElementName=Root}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding TimelineLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding TimelineTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding TimelineWidth}"
                                          Height="34"
                                          MinWidth="24"
                                          ClipToBounds="False">
                                        <Thumb Tag="{Binding}"
                                               Width="{Binding TimelineWidth}"
                                               Cursor="SizeAll"
                                               PreviewMouseLeftButtonDown="InputTimelineNode_SelectOnly"
                                               DragStarted="InputTimelineNode_DragStarted"
                                               DragDelta="InputTimelineNode_DragDelta"
                                               DragCompleted="InputTimelineNode_DragCompleted">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid ClipToBounds="False">
                                                        <Border Background="{Binding NodeBrush}"
                                                                BorderBrush="{Binding BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"/>
                                                        <ItemsControl ItemsSource="{Binding MarkerRows}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                                    <Setter Property="Canvas.Top" Value="0"/>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="1" Height="34" Background="#B45309"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding TimelineText}"
                                                                   Width="{Binding TimelineLabelWidth}"
                                                                   Margin="6,3,0,0"
                                                                   Foreground="#1E3A8A"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="NoWrap"
                                                                   IsHitTestVisible="False"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                        <Thumb Width="12"
                                               HorizontalAlignment="Right"
                                               Cursor="SizeWE"
                                               Tag="{Binding}"
                                               PreviewMouseLeftButtonDown="InputTimelineNode_SelectOnly"
                                               DragStarted="InputTimelineResize_DragStarted"
                                               DragDelta="InputTimelineResize_DragDelta"
                                               DragCompleted="InputTimelineNode_DragCompleted">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#1D4ED8" Opacity="0.75"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Canvas.Left="{Binding InputTimelineDragPreviewLeft, ElementName=Root}"
                                   Canvas.Top="{Binding InputTimelineDragPreviewTop, ElementName=Root}"
                                   Width="{Binding InputTimelineDragPreviewWidth, ElementName=Root}"
                                   Height="34"
                                   Stroke="#0F172A"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 2"
                                   Fill="#60FFFFFF"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding IsInputTimelineDragPreviewVisible, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Border Canvas.Left="{Binding InputTimelineDragPreviewLeft, ElementName=Root}"
                                Canvas.Top="{Binding InputTimelineDragPreviewLabelTop, ElementName=Root}"
                                Background="#0F172A"
                                CornerRadius="3"
                                Padding="6,2"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsInputTimelineDragPreviewVisible, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding InputTimelineDragPreviewText, ElementName=Root}"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Canvas>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Visibility="{Binding FullVisibility, ElementName=Root}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <Border x:Name="RightPane"
                    Grid.Column="2"
                    Visibility="{Binding FullVisibility, ElementName=Root}"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="選択ノード"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding SelectedNodeTitle, ElementName=Root}"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="開始F"/>
                        <TextBox x:Name="InputNodeFrameTextBox"
                                 Margin="0,2,0,8"
                                 Text="{Binding SelectedInputNodeRow.DisplayFrame, ElementName=Root, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="保持F"/>
                        <TextBox Margin="0,2,0,8"
                                 Text="{Binding SelectedInputNodeRow.DurationFrames, ElementName=Root, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="入力表記"/>
                        <TextBox x:Name="InputNodeInputsTextBox"
                                 Margin="0,2,0,8"
                                 Text="{Binding SelectedInputNodeRow.InputsText, ElementName=Root, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="表示ラベル"/>
                        <TextBox Margin="0,2,0,8"
                                 Text="{Binding SelectedInputNodeRow.DisplayLabel, ElementName=Root, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="色タグ"/>
                        <TextBox Margin="0,2,0,8"
                                 Text="{Binding SelectedInputNodeRow.ColorTag, ElementName=Root, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="{Binding SelectedPhysicalPreview, ElementName=Root}"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedWarningText, ElementName=Root}"
                                   Foreground="#B45309"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="方向" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <UniformGrid Columns="3" Rows="3" Width="170" HorizontalAlignment="Left">
                            <Button Content="7" Tag="7" Click="SetInputNodeDirection_Click"/>
                            <Button Content="8" Tag="8" Click="SetInputNodeDirection_Click"/>
                            <Button Content="9" Tag="9" Click="SetInputNodeDirection_Click"/>
                            <Button Content="4" Tag="4" Click="SetInputNodeDirection_Click"/>
                            <Button Content="5" Tag="5" Click="SetInputNodeDirection_Click"/>
                            <Button Content="6" Tag="6" Click="SetInputNodeDirection_Click"/>
                            <Button Content="1" Tag="1" Click="SetInputNodeDirection_Click"/>
                            <Button Content="2" Tag="2" Click="SetInputNodeDirection_Click"/>
                            <Button Content="3" Tag="3" Click="SetInputNodeDirection_Click"/>
                        </UniformGrid>
                        <TextBlock Text="攻撃" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <WrapPanel>
                            <Button Content="lp" Tag="lp" Click="ToggleInputNodeAttack_Click"/>
                            <Button Content="mp" Tag="mp" Click="ToggleInputNodeAttack_Click"/>
                            <Button Content="hp" Tag="hp" Click="ToggleInputNodeAttack_Click"/>
                            <Button Content="lk" Tag="lk" Click="ToggleInputNodeAttack_Click"/>
                            <Button Content="mk" Tag="mk" Click="ToggleInputNodeAttack_Click"/>
                            <Button Content="hk" Tag="hk" Click="ToggleInputNodeAttack_Click"/>
                        </WrapPanel>
                        <Expander Header="プリセット" Margin="0,12,0,0">
                            <StackPanel>
                                <ListBox Height="90"
                                         ItemsSource="{Binding Presets, ElementName=Root}"
                                         SelectedItem="{Binding SelectedPreset, ElementName=Root, Mode=TwoWay}"
                                         DisplayMemberPath="Name"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="現在Fへ追加" Click="AddPresetAtCurrentFrame_Click"/>
                                    <Button Content="選択ノードを保存" Click="SaveSelectedNodeAsPreset_Click"/>
                                    <Button Content="削除" Click="DeletePreset_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        <Expander Header="詳細表" Margin="0,12,0,0">
                            <DataGrid x:Name="InputEventGrid"
                                      Height="170"
                                      ItemsSource="{Binding ActionDefinition.InputEvents, ElementName=Root}"
                                      SelectedItem="{Binding SelectedInputEvent, ElementName=Root, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="表示F" Width="70" Binding="{Binding DisplayFrame, UpdateSourceTrigger=LostFocus}"/>
                                    <DataGridTextColumn Header="保持F" Width="65" Binding="{Binding DurationFrames, UpdateSourceTrigger=LostFocus}"/>
                                    <DataGridTextColumn Header="論理入力" Width="*" Binding="{Binding LogicalInputsText, UpdateSourceTrigger=LostFocus}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
