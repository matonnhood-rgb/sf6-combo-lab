<Window x:Class="ComboLab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ComboLab.Views"
        Title="Combo Lab"
        Width="1180"
        Height="840"
        MinWidth="920"
        MinHeight="700">
    <Window.Resources>
        <local:UnregisteredActionWarningConverter x:Key="UnregisteredActionWarningConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,10"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="JSONを開く" Click="Load_Click"/>
                <Button Content="上書き保存" Click="OverwriteSave_Click"/>
                <Button Content="名前を付けて保存" Click="SaveAs_Click"/>
                <Separator Margin="4,0,10,0"/>
                <Button Content="共有文をコピー" Click="CopyShareText_Click"/>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="#555555"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabControl">
            <TabItem Header="コンボ編集">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="コンボ一覧"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="4,2,4,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="新規登録" Click="NewCombo_Click"/>
                                    <Button Content="削除" Click="DeleteCombo_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <ListBox x:Name="ComboList"
                                     ItemsSource="{Binding Library.Combos}"
                                     SelectedItem="{Binding SelectedCombo, Mode=TwoWay}"
                                     PreviewMouseRightButtonDown="ComboList_PreviewMouseRightButtonDown">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="新規登録" Click="NewCombo_Click"/>
                                        <MenuItem Header="削除" Click="DeleteCombo_Click"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,5">
                                            <TextBlock Text="{Binding ComboName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="#666666" FontSize="12">
                                                <Run Text="{Binding Damage}"/>
                                                <Run Text=" ダメージ"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"/>

                    <Grid Grid.Column="2" x:Name="EditorPanel" IsEnabled="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12">
                            <Grid DataContext="{Binding SelectedCombo}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="コンボ名"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding ComboName, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Grid.Row="0" Grid.Column="2" Content="ダメージ"/>
                                <TextBox Grid.Row="0" Grid.Column="3"
                                         Text="{Binding Damage, UpdateSourceTrigger=LostFocus}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="タグ"/>
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ListBox x:Name="TagList"
                                             Grid.ColumnSpan="2"
                                             Height="58"
                                             ItemsSource="{Binding Tags}"
                                             SelectedItem="{Binding DataContext.SelectedTag, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                    <TextBox x:Name="TagInput"
                                             Grid.Row="1"
                                             Margin="0,6,6,6"
                                             ToolTip="自由なタグ名を入力"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1"
                                                Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <Button Content="追加" Click="AddTag_Click"/>
                                        <Button Content="選択タグを削除" Click="RemoveTag_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Label Grid.Row="2" Grid.Column="0" Content="メモ"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                         Height="70"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,8">
                                    <TextBlock Text="コンボタイムライン"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="2,0,18,0"/>
                                    <Button Content="アクション追加" Click="AddActionNode_Click"/>
                                    <Button Content="メモ追加" Click="AddNoteNode_Click"/>
                                    <Button Content="コンボ呼び出し追加" Click="AddComboCallNode_Click"/>
                                    <Button Content="ノード削除" Click="DeleteNode_Click"/>
                                    <Button Content="上へ" Click="MoveStepUp_Click"/>
                                    <Button Content="下へ" Click="MoveStepDown_Click"/>
                                    <Button Content="展開表示" Click="ShowExpandedTimeline_Click"/>
                                </StackPanel>

                                <DataGrid x:Name="TimelineGrid"
                                          ItemsSource="{Binding SelectedCombo.Steps}"
                                          SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="入力F"
                                                            Width="75"
                                                            Binding="{Binding DisplayInputFrame, UpdateSourceTrigger=LostFocus}"/>
                                        <DataGridTextColumn Header="ノード種別"
                                                            Width="130"
                                                            IsReadOnly="True"
                                                            Binding="{Binding NodeTypeDisplay}"/>
                                        <DataGridTemplateColumn Header="内容" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBlock x:Name="PlainContent"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Content}"/>
                                                        <TextBlock x:Name="ActionContent"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding ActionName}"
                                                                   Visibility="Collapsed"/>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding NodeType}" Value="Action">
                                                            <Setter TargetName="PlainContent" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="ActionContent" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBox x:Name="PlainEditor"
                                                                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <ComboBox x:Name="ActionEditor"
                                                                  Visibility="Collapsed"
                                                                  IsEditable="True"
                                                                  IsTextSearchEnabled="True"
                                                                  StaysOpenOnEdit="True"
                                                                  ItemsSource="{Binding DataContext.ActionNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  Text="{Binding ActionName, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding NodeType}" Value="Action">
                                                            <Setter TargetName="PlainEditor" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="ActionEditor" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="定義" Width="125" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Foreground="#B45309" VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource UnregisteredActionWarningConverter}">
                                                                <Binding Path="."/>
                                                                <Binding Path="DataContext.Library.ActionDefinitions"
                                                                         RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="アクション編集">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="アクション一覧"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="4,2,4,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="新規作成" Click="NewActionDefinition_Click"/>
                                    <Button Content="削除" Click="DeleteActionDefinition_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <ListBox x:Name="ActionDefinitionList"
                                     ItemsSource="{Binding Library.ActionDefinitions}"
                                     SelectedItem="{Binding SelectedActionDefinition, Mode=TwoWay}"
                                     DisplayMemberPath="ActionName"/>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"/>

                    <Grid Grid.Column="2"
                          x:Name="ActionEditorPanel"
                          IsEnabled="False"
                          DataContext="{Binding SelectedActionDefinition}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Content="アクション名"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding ActionName, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Grid.Row="1" Content="説明"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Height="64"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top"
                                            Margin="0,0,0,8">
                                    <WrapPanel x:Name="InputEventEditButtonsPanel"
                                               Margin="0,0,0,6">
                                        <TextBlock Text="入力イベント"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="2,0,18,0"/>
                                        <Button Content="イベント追加" Click="AddInputEvent_Click"/>
                                        <Button Content="イベント削除" Click="DeleteInputEvent_Click"/>
                                        <Button Content="上へ" Click="MoveInputEventUp_Click"/>
                                        <Button Content="下へ" Click="MoveInputEventDown_Click"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="送信方式:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <ComboBox x:Name="KeyboardSendModeComboBox"
                                                  Width="140"
                                                  Margin="0,0,8,0"
                                                  ItemsSource="{Binding DataContext.KeyboardSendModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding DataContext.SelectedKeyboardSendMode, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                        <TextBlock Text="保持時間:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <ComboBox x:Name="PressDurationComboBox"
                                                  Width="82"
                                                  Margin="0,0,4,0"
                                                  ItemsSource="{Binding DataContext.PressDurationOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding DataContext.SelectedPressDuration, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                        <TextBox x:Name="CustomPressMillisecondsTextBox"
                                                 Width="62"
                                                 Margin="0,0,4,0"
                                                 ToolTip="ms指定を選んだ場合の保持時間"
                                                 IsEnabled="{Binding DataContext.IsCustomPressDuration, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Text="{Binding DataContext.CustomPressMilliseconds, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="ms"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="開始待ち:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <ComboBox x:Name="StartDelayComboBox"
                                                  Width="74"
                                                  Margin="0,0,8,0"
                                                  ItemsSource="{Binding DataContext.StartDelayOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Seconds"
                                                  SelectedValue="{Binding DataContext.SelectedStartDelaySeconds, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                        <Button x:Name="TestPlaybackButton"
                                                Content="テスト再生"
                                                Click="TestPlayback_Click"/>
                                        <Button x:Name="CancelTestPlaybackButton"
                                                Content="キャンセル"
                                                IsEnabled="False"
                                                Click="CancelTestPlayback_Click"/>
                                    </WrapPanel>
                                    <WrapPanel x:Name="PresentSyncSettingsPanel"
                                               Margin="0,6,0,0">
                                        <CheckBox x:Name="PresentSyncEnabledCheckBox"
                                                  Content="Present同期"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  IsChecked="{Binding DataContext.IsPresentSyncEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                        <TextBlock Text="PresentMon:"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="PresentMonExePathTextBox"
                                                 Width="190"
                                                 Margin="4,0"
                                                 Text="{Binding DataContext.PresentMonExePath, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="参照"
                                                Click="BrowsePresentMon_Click"/>
                                        <TextBlock Text="PID:"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,2,0"/>
                                        <TextBox Width="64"
                                                 Text="{Binding DataContext.PresentProcessIdText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="プロセス名:"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,2,0"/>
                                        <TextBox Width="125"
                                                 Text="{Binding DataContext.PresentProcessName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="開始遅延F:"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,2,0"/>
                                        <TextBox Width="42"
                                                 Text="{Binding DataContext.PresentStartDelayFrames, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="位相補正ms:"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,2,0"/>
                                        <TextBox Width="54"
                                                 Text="{Binding DataContext.InputPhaseOffsetText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="必要サンプル:"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,2,0"/>
                                        <TextBox Width="42"
                                                 Text="{Binding DataContext.RequiredPresentSamples, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="フレーム落ち:"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,2,0"/>
                                        <ComboBox x:Name="PresentDropBehaviorComboBox"
                                                  Width="90"
                                                  ItemsSource="{Binding DataContext.PresentDropBehaviorOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding DataContext.SelectedPresentDropBehavior, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="2,5,0,0">
                                        <TextBlock x:Name="PresentSyncStatusText"
                                                   Text="Sync: OFF"
                                                   FontWeight="SemiBold"
                                                   Foreground="#475569"/>
                                        <TextBlock x:Name="PresentSyncDetailText"
                                                   Margin="12,0,0,0"
                                                   Foreground="#475569"/>
                                    </WrapPanel>
                                    
                                    <TextBlock x:Name="TestPlaybackStatusText"
                                               Margin="2,6,0,0"
                                               Foreground="#B45309"/>
                                </StackPanel>

                                <TextBox x:Name="TestPlaybackLogText"
                                         DockPanel.Dock="Bottom"
                                         Height="92"
                                         Margin="0,8,0,0"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         ToolTip="直近の入力イベント、送信予定表、送信結果。詳細ログはlogsフォルダーへ保存します。"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="420"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border x:Name="InputNodeEditorPanel"
                                            BorderBrush="#D0D0D0"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <ListBox x:Name="InputNodeList"
                                                     Grid.Row="2"
                                                     ItemsSource="{Binding DataContext.InputNodeRows, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     SelectedItem="{Binding DataContext.SelectedInputNodeRow, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="4,5">
                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding PhysicalPreview}"
                                                                       Foreground="#475569"
                                                                       FontSize="12"/>
                                                            <TextBlock Text="{Binding WarningText}"
                                                                       Foreground="#B45309"
                                                                       FontSize="12"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <StackPanel>
                                                <Border BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        Background="#F8FAFC"
                                                        Height="220"
                                                        Margin="0,0,0,8">
                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <Canvas x:Name="InputTimelineCanvas"
                                                                Width="{Binding DataContext.InputTimelineWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Height="{Binding DataContext.InputTimelineHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                MouseLeftButtonDown="InputTimelineCanvas_MouseLeftButtonDown">
                                                            <Canvas.Background>
                                                                <DrawingBrush TileMode="Tile"
                                                                              Viewport="0,0,28,42"
                                                                              ViewportUnits="Absolute">
                                                                    <DrawingBrush.Drawing>
                                                                        <DrawingGroup>
                                                                            <GeometryDrawing Geometry="M0,0 L28,0">
                                                                                <GeometryDrawing.Pen>
                                                                                    <Pen Brush="#E2E8F0" Thickness="1"/>
                                                                                </GeometryDrawing.Pen>
                                                                            </GeometryDrawing>
                                                                            <GeometryDrawing Geometry="M0,0 L0,42">
                                                                                <GeometryDrawing.Pen>
                                                                                    <Pen Brush="#E2E8F0" Thickness="1"/>
                                                                                </GeometryDrawing.Pen>
                                                                            </GeometryDrawing>
                                                                        </DrawingGroup>
                                                                    </DrawingBrush.Drawing>
                                                                </DrawingBrush>
                                                            </Canvas.Background>
                                                            <ItemsControl ItemsSource="{Binding DataContext.InputTimelineTicks, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <Canvas/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                                        <Setter Property="Canvas.Top" Value="0"/>
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Width="28"
                                                                              Height="{Binding DataContext.InputTimelineHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                            <Border Width="1"
                                                                                    Height="{Binding DataContext.InputTimelineHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    HorizontalAlignment="Left"
                                                                                    Background="#E2E8F0"/>
                                                                            <TextBlock Text="{Binding Label}"
                                                                                       Margin="2,2,0,0"
                                                                                       FontSize="10"
                                                                                       Foreground="#64748B"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ItemsControl ItemsSource="{Binding DataContext.InputNodeRows, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <Canvas/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Canvas.Left" Value="{Binding TimelineLeft}"/>
                                                                        <Setter Property="Canvas.Top" Value="{Binding TimelineTop}"/>
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Width="{Binding TimelineWidth}"
                                                                              Height="34"
                                                                              MinWidth="34"
                                                                              ClipToBounds="False">
                                                                            <Thumb Tag="{Binding}"
                                                                                   Width="{Binding TimelineWidth}"
                                                                                   Cursor="SizeAll"
                                                                                   PreviewMouseLeftButtonDown="InputTimelineNode_SelectOnly"
                                                                                   DragStarted="InputTimelineNode_DragStarted"
                                                                                   DragDelta="InputTimelineNode_DragDelta"
                                                                                   DragCompleted="InputTimelineNode_DragCompleted">
                                                                                <Thumb.Template>
                                                                                    <ControlTemplate TargetType="Thumb">
                                                                                        <Grid ClipToBounds="False">
                                                                                            <Border Background="#DBEAFE"
                                                                                                    BorderBrush="#2563EB"
                                                                                                    BorderThickness="1"
                                                                                                    CornerRadius="3"/>
                                                                                            <TextBlock Text="{Binding TimelineText}"
                                                                                                       Width="{Binding TimelineLabelWidth}"
                                                                                                       Margin="6,3,0,0"
                                                                                                       Foreground="#1E3A8A"
                                                                                                       FontWeight="SemiBold"
                                                                                                       TextWrapping="NoWrap"
                                                                                                       IsHitTestVisible="False"/>
                                                                                        </Grid>
                                                                                    </ControlTemplate>
                                                                                </Thumb.Template>
                                                                            </Thumb>
                                                                            <Thumb Width="12"
                                                                                   HorizontalAlignment="Right"
                                                                                   Cursor="SizeWE"
                                                                                   Tag="{Binding}"
                                                                                   PreviewMouseLeftButtonDown="InputTimelineNode_SelectOnly"
                                                                                   DragStarted="InputTimelineResize_DragStarted"
                                                                                   DragDelta="InputTimelineResize_DragDelta"
                                                                                   DragCompleted="InputTimelineNode_DragCompleted">
                                                                                <Thumb.Template>
                                                                                    <ControlTemplate TargetType="Thumb">
                                                                                        <Border Background="#1D4ED8" Opacity="0.75"/>
                                                                                    </ControlTemplate>
                                                                                </Thumb.Template>
                                                                            </Thumb>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Rectangle Canvas.Left="{Binding DataContext.InputTimelineDragPreviewLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       Canvas.Top="{Binding DataContext.InputTimelineDragPreviewTop, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       Width="{Binding DataContext.InputTimelineDragPreviewWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       Height="34"
                                                                       Stroke="#0F172A"
                                                                       StrokeThickness="2"
                                                                       StrokeDashArray="4 2"
                                                                       Fill="#60FFFFFF"
                                                                       IsHitTestVisible="False"
                                                                       Visibility="{Binding DataContext.IsInputTimelineDragPreviewVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Border Canvas.Left="{Binding DataContext.InputTimelineDragPreviewLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Canvas.Top="{Binding DataContext.InputTimelineDragPreviewLabelTop, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Background="#0F172A"
                                                                    CornerRadius="3"
                                                                    Padding="6,2"
                                                                    IsHitTestVisible="False"
                                                                    Visibility="{Binding DataContext.IsInputTimelineDragPreviewVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding DataContext.InputTimelineDragPreviewText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           Foreground="White"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Canvas>
                                                    </ScrollViewer>
                                                </Border>

                                                <WrapPanel Margin="0,0,0,8">
                                                    <Button Content="ノード追加" Click="AddInputEvent_Click"/>
                                                    <Button Content="ノード削除" Click="DeleteInputEvent_Click"/>
                                                    <Button Content="複製" Click="DuplicateInputNode_Click"/>
                                                    <Button Content="上へ" Click="MoveInputEventUp_Click"/>
                                                    <Button Content="下へ" Click="MoveInputEventDown_Click"/>
                                                    <Button Content="F順に並べ替え" Click="SortInputNodesByFrame_Click"/>
                                                    <Button Content="入力クリア" Click="ClearInputNode_Click"/>
                                                </WrapPanel>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="フレーム"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox x:Name="InputNodeFrameTextBox"
                                                             Grid.Column="1"
                                                             Text="{Binding SelectedInputNodeRow.DisplayFrame, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="入力表記"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0"/>
                                                    <TextBox x:Name="InputNodeInputsTextBox"
                                                             Grid.Column="3"
                                                             Text="{Binding SelectedInputNodeRow.InputsText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"/>
                                                </Grid>

                                                <UniformGrid Columns="3"
                                                             Rows="3"
                                                             Width="150"
                                                             HorizontalAlignment="Left">
                                                    <Button Content="7" Tag="7" Click="SetInputNodeDirection_Click"/>
                                                    <Button Content="8" Tag="8" Click="SetInputNodeDirection_Click"/>
                                                    <Button Content="9" Tag="9" Click="SetInputNodeDirection_Click"/>
                                                    <Button Content="4" Tag="4" Click="SetInputNodeDirection_Click"/>
                                                    <Button Content="5" Tag="5" Click="SetInputNodeDirection_Click"/>
                                                    <Button Content="6" Tag="6" Click="SetInputNodeDirection_Click"/>
                                                    <Button Content="1" Tag="1" Click="SetInputNodeDirection_Click"/>
                                                    <Button Content="2" Tag="2" Click="SetInputNodeDirection_Click"/>
                                                    <Button Content="3" Tag="3" Click="SetInputNodeDirection_Click"/>
                                                </UniformGrid>

                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Content="lp" Tag="lp" Click="ToggleInputNodeAttack_Click"/>
                                                    <Button Content="mp" Tag="mp" Click="ToggleInputNodeAttack_Click"/>
                                                    <Button Content="hp" Tag="hp" Click="ToggleInputNodeAttack_Click"/>
                                                    <Button Content="lk" Tag="lk" Click="ToggleInputNodeAttack_Click"/>
                                                    <Button Content="mk" Tag="mk" Click="ToggleInputNodeAttack_Click"/>
                                                    <Button Content="hk" Tag="hk" Click="ToggleInputNodeAttack_Click"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <DataGrid x:Name="InputEventGrid"
                                              Grid.Row="2"
                                              ItemsSource="{Binding InputEvents}"
                                              SelectedItem="{Binding DataContext.SelectedInputEvent, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              RowHeaderWidth="0"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="フレーム"
                                                                Width="90"
                                                                Binding="{Binding DisplayFrame, UpdateSourceTrigger=LostFocus}"/>
                                            <DataGridTextColumn Header="保持F"
                                                                Width="80"
                                                                Binding="{Binding DurationFrames, UpdateSourceTrigger=LostFocus}"/>
                                            <DataGridTextColumn Header="論理入力（カンマ区切り）"
                                                                Width="*"
                                                                Binding="{Binding LogicalInputsText, UpdateSourceTrigger=LostFocus}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="キーマップ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <WrapPanel>
                            <TextBlock Text="プロファイル:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBox Width="220"
                                     Margin="0,0,8,0"
                                     Text="{Binding ActiveKeyMapProfile.Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="入力追加"
                                    Click="AddKeyMapBinding_Click"/>
                            <Button Content="入力削除"
                                    Click="DeleteKeyMapBinding_Click"/>
                            <Button Content="保存"
                                    Click="SaveKeyMap_Click"/>
                            <Button Content="デフォルトに戻す"
                                    Click="ResetKeyMap_Click"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <DataGrid x:Name="KeyMapGrid"
                                      ItemsSource="{Binding KeyMapBindingRows}"
                                      SelectedItem="{Binding SelectedKeyMapBindingRow, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="入力イベントに記載する表記"
                                                        Width="160"
                                                        Binding="{Binding Action, UpdateSourceTrigger=LostFocus}"/>
                                    <DataGridTemplateColumn Header="物理キー" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding KeysText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding KeysText, UpdateSourceTrigger=PropertyChanged}"
                                                         PreviewKeyDown="KeyMapKeyTextBox_PreviewKeyDown"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Column="2"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="表記プレビュー"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding KeyMapPreviewLines}"/>
                                <TextBlock Text="物理キー欄を編集中にキーボードを押すと、Space や A のようなキー名で上書きされます。複数キーはカンマ区切りでも編集できます。"
                                           TextWrapping="Wrap"
                                           Foreground="#475569"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

