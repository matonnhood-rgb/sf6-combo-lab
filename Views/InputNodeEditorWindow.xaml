<Window x:Class="ComboLab.Views.InputNodeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入力ノード編集"
        Width="1380"
        Height="820"
        MinWidth="1080"
        MinHeight="680">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top"
                BorderBrush="#CBD5E1"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,8"
                Margin="0,0,0,8">
            <WrapPanel x:Name="EditorToolbar" VerticalAlignment="Center">
                <TextBlock Text="{Binding ActionNameText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0"/>
                <Button Content="ノード追加" Click="AddInputEvent_Click"/>
                <Button Content="ノード削除" Click="DeleteInputEvent_Click"/>
                <Button Content="複製" Click="DuplicateInputNode_Click"/>
                <Button Content="入力クリア" Click="ClearInputNode_Click"/>
                <Button Content="F順に並べ替え" Click="SortInputNodesByFrame_Click"/>
                <TextBlock Text="ズーム"
                           Margin="18,0,4,0"
                           VerticalAlignment="Center"/>
                <Slider Width="130"
                        Minimum="16"
                        Maximum="48"
                        TickFrequency="4"
                        IsSnapToTickEnabled="True"
                        Value="{Binding PixelsPerFrame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="テスト再生"
                        Margin="18,0,0,0"
                        Click="TestPlayback_Click"/>
                <Button Content="閉じる"
                        Margin="8,0,0,0"
                        Click="Close_Click"/>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Background="#F8FAFC"
                Padding="8"
                Margin="0,8,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#475569"
                           VerticalAlignment="Center"/>
                <Expander Header="詳細表"
                          DockPanel.Dock="Right"
                          Width="520"
                          HorizontalAlignment="Right">
                    <DataGrid x:Name="InputEventGrid"
                              Margin="8,6,0,0"
                              Height="170"
                              ItemsSource="{Binding ActionDefinition.InputEvents}"
                              SelectedItem="{Binding SelectedInputEvent, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="表示F"
                                                Width="90"
                                                Binding="{Binding DisplayFrame, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="保持F"
                                                Width="80"
                                                Binding="{Binding DurationFrames, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="論理入力"
                                                Width="*"
                                                Binding="{Binding LogicalInputsText, UpdateSourceTrigger=LostFocus}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Background="#F8FAFC">
                <ScrollViewer x:Name="TimelineScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RequestBringIntoView="TimelineScrollViewer_RequestBringIntoView">
                    <Canvas x:Name="InputTimelineCanvas"
                            Width="{Binding InputTimelineWidth}"
                            Height="{Binding InputTimelineHeight}"
                            MouseLeftButtonDown="InputTimelineCanvas_MouseLeftButtonDown">
                        <Canvas.Background>
                            <DrawingBrush TileMode="Tile"
                                          Viewport="{Binding TimelineGridViewport}"
                                          ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Geometry="M0,0 L0,42">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#E2E8F0" Thickness="1"/>
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Canvas.Background>

                        <ItemsControl ItemsSource="{Binding InputTimelineLaneLines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="0"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding DataContext.InputTimelineWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Height="1"
                                            Background="#E2E8F0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding InputTimelineTicks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="0"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding DataContext.PixelsPerFrame, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Height="{Binding DataContext.InputTimelineHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border Width="1"
                                                HorizontalAlignment="Left"
                                                Background="#CBD5E1"/>
                                        <TextBlock Text="{Binding Label}"
                                                   Margin="2,2,0,0"
                                                   FontSize="10"
                                                   Foreground="#475569"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding InputNodeRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding TimelineLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding TimelineTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding TimelineWidth}"
                                          Height="34"
                                          MinWidth="24"
                                          ClipToBounds="False">
                                        <Thumb Tag="{Binding}"
                                               Width="{Binding TimelineWidth}"
                                               Cursor="SizeAll"
                                               PreviewMouseLeftButtonDown="InputTimelineNode_SelectOnly"
                                               DragStarted="InputTimelineNode_DragStarted"
                                               DragDelta="InputTimelineNode_DragDelta"
                                               DragCompleted="InputTimelineNode_DragCompleted">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid ClipToBounds="False">
                                                        <Border Background="#DBEAFE"
                                                                BorderBrush="#2563EB"
                                                                BorderThickness="1"
                                                                CornerRadius="3"/>
                                                        <TextBlock Text="{Binding TimelineText}"
                                                                   Width="{Binding TimelineLabelWidth}"
                                                                   Margin="6,3,0,0"
                                                                   Foreground="#1E3A8A"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="NoWrap"
                                                                   IsHitTestVisible="False"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                        <Thumb Width="12"
                                               HorizontalAlignment="Right"
                                               Cursor="SizeWE"
                                               Tag="{Binding}"
                                               PreviewMouseLeftButtonDown="InputTimelineNode_SelectOnly"
                                               DragStarted="InputTimelineResize_DragStarted"
                                               DragDelta="InputTimelineResize_DragDelta"
                                               DragCompleted="InputTimelineNode_DragCompleted">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#1D4ED8" Opacity="0.75"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Canvas.Left="{Binding InputTimelineDragPreviewLeft}"
                                   Canvas.Top="{Binding InputTimelineDragPreviewTop}"
                                   Width="{Binding InputTimelineDragPreviewWidth}"
                                   Height="34"
                                   Stroke="#0F172A"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 2"
                                   Fill="#60FFFFFF"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding IsInputTimelineDragPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Border Canvas.Left="{Binding InputTimelineDragPreviewLeft}"
                                Canvas.Top="{Binding InputTimelineDragPreviewLabelTop}"
                                Background="#0F172A"
                                CornerRadius="3"
                                Padding="6,2"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsInputTimelineDragPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding InputTimelineDragPreviewText}"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Canvas>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <Border x:Name="RightPane"
                    Grid.Column="2"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="選択ノード"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding SelectedNodeTitle}"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="開始F"/>
                    <TextBox x:Name="InputNodeFrameTextBox"
                             Margin="0,2,0,8"
                             Text="{Binding SelectedInputNodeRow.DisplayFrame, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="保持F"/>
                    <TextBox x:Name="InputNodeDurationTextBox"
                             Margin="0,2,0,8"
                             Text="{Binding SelectedInputNodeRow.DurationFrames, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="入力表記"/>
                    <TextBox x:Name="InputNodeInputsTextBox"
                             Margin="0,2,0,8"
                             Text="{Binding SelectedInputNodeRow.InputsText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="{Binding SelectedPhysicalPreview}"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedWarningText}"
                               Foreground="#B45309"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="方向"
                               FontWeight="SemiBold"
                               Margin="0,4,0,4"/>
                    <UniformGrid Columns="3"
                                 Rows="3"
                                 Width="170"
                                 HorizontalAlignment="Left">
                        <Button Content="7" Tag="7" Click="SetInputNodeDirection_Click"/>
                        <Button Content="8" Tag="8" Click="SetInputNodeDirection_Click"/>
                        <Button Content="9" Tag="9" Click="SetInputNodeDirection_Click"/>
                        <Button Content="4" Tag="4" Click="SetInputNodeDirection_Click"/>
                        <Button Content="5" Tag="5" Click="SetInputNodeDirection_Click"/>
                        <Button Content="6" Tag="6" Click="SetInputNodeDirection_Click"/>
                        <Button Content="1" Tag="1" Click="SetInputNodeDirection_Click"/>
                        <Button Content="2" Tag="2" Click="SetInputNodeDirection_Click"/>
                        <Button Content="3" Tag="3" Click="SetInputNodeDirection_Click"/>
                    </UniformGrid>

                    <TextBlock Text="攻撃"
                               FontWeight="SemiBold"
                               Margin="0,12,0,4"/>
                    <WrapPanel>
                        <Button Content="lp" Tag="lp" Click="ToggleInputNodeAttack_Click"/>
                        <Button Content="mp" Tag="mp" Click="ToggleInputNodeAttack_Click"/>
                        <Button Content="hp" Tag="hp" Click="ToggleInputNodeAttack_Click"/>
                        <Button Content="lk" Tag="lk" Click="ToggleInputNodeAttack_Click"/>
                        <Button Content="mk" Tag="mk" Click="ToggleInputNodeAttack_Click"/>
                        <Button Content="hk" Tag="hk" Click="ToggleInputNodeAttack_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
