<Window x:Class="ComboLab.Views.InputNodeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ComboLab.Views"
        Title="入力ノード編集"
        Width="1380"
        Height="820"
        MinWidth="1080"
        MinHeight="680">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top"
                BorderBrush="#CBD5E1"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,8"
                Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="{Binding ActionNameText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Content="閉じる"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Padding="14,4"
                        Click="Close_Click"/>
            </DockPanel>
        </Border>

        <local:InputNodeTimelineEditorControl x:Name="TimelineEditor"
                                              ActionDefinition="{Binding ActionDefinition}"
                                              ActiveKeyMapProfile="{Binding ActiveKeyMapProfile}"
                                              IsCompact="False"
                                              TestPlaybackRequested="TimelineEditor_TestPlaybackRequested"/>
    </DockPanel>
</Window>
